# WhatsApp Caller - Environment Variables
# Copy this file to .env and adjust values as needed

# Server configuration
PORT=3000
CORS_ORIGIN=*

# Authentication directory (session persistence)
AUTH_DIR=/app/auth

# TTS cache directory
TTS_DIR=/app/tts-cache

# WhatsApp Web WASM resources path (optional, defaults to assets/wasm/)
# WASM_PATH=/app/assets/wasm/whatsapp.wasm

# Logging
LOG_LEVEL=info
